table ATIVOS_Software
	lineageTag: 5c1b7054-9740-48fb-b63b-60dd9039e9e4

	measure 'Licenças Adquiridas' = SUM ( ATIVOS_Software[Licenças_Adquiridas] )
		formatString: #,0
		displayFolder: Ativos TI\Software
		lineageTag: 0b4a4f71-e6be-4e99-a860-f26b2f701795

	measure 'Licenças Utilizadas' = SUM ( ATIVOS_Software[Licenças_Utilizadas] )
		formatString: #,0
		displayFolder: Ativos TI\Software
		lineageTag: 9eee9e44-6c5b-4b93-8ab9-161e13c48b7d

	measure 'Licenças Disponíveis' = SUM ( ATIVOS_Software[Licenças_Disponíveis] )
		formatString: #,0
		displayFolder: Ativos TI\Software
		lineageTag: fe0750c9-c461-4f9a-a5f6-1694935444d3

	measure '% Licenças Utilizadas' = DIVIDE ( [Licenças Utilizadas], [Licenças Adquiridas] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ativos TI\Software
		lineageTag: 66924498-0c87-4f50-8426-bb53e563e966

	measure 'Drift Licenças' = [Licenças Adquiridas] - [Licenças Utilizadas]
		formatString: #,0
		displayFolder: Ativos TI\Software
		lineageTag: ed488513-2197-4c86-a1cd-2b4d33fec930

	measure 'Custo Anual Software' = SUM ( ATIVOS_Software[Custo_Anual_€] )
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Ativos TI\Software
		lineageTag: e954f302-74e9-41d8-a1cc-975e8864fbc8

	measure 'Custo Licenças Desperdiçadas' = SUMX ( ATIVOS_Software, ATIVOS_Software[Licenças_Disponíveis] * ATIVOS_Software[Custo_Por_Licença_€] )
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Ativos TI\Software
		lineageTag: ed3cd594-d525-46ca-928a-86950a5ae37d

