table CYBER_Vulnerabilidades
	lineageTag: e39dee59-d452-4eb1-a4ae-f27053a2ac1e

	measure 'Total Vulnerabilidades' = COUNTROWS ( CYBER_Vulnerabilidades )
		formatString: #,0
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: db0c9871-388b-436c-9618-3ae2418bf2f5

	measure 'Vulnerabilidades Abertas' = CALCULATE ( [Total Vulnerabilidades], CYBER_Vulnerabilidades[Estado] = "Aberta" ) + 0
		formatString: #,0
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: e4ac7b14-6542-4bf3-9a1d-bfdcbf4e518c

	measure 'Vulnerabilidades Críticas Abertas' = CALCULATE ( [Total Vulnerabilidades], CYBER_Vulnerabilidades[Estado] = "Aberta", CYBER_Vulnerabilidades[Criticidade] = "Crítico" ) + 0
		formatString: #,0
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: cd90cccc-5df4-4340-a189-2ab4c13bb960

	measure 'CVSS Médio' = AVERAGE ( CYBER_Vulnerabilidades[CVSS_Score] )
		formatString: #,0.00
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: 35c6b519-f4a4-457e-9539-a0e1a35794e4

	measure 'Dias em Aberto Médio' = CALCULATE ( AVERAGE ( CYBER_Vulnerabilidades[Dias_Aberto] ), CYBER_Vulnerabilidades[Estado] = "Aberta" )
		formatString: #,0.00
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: b9f99e83-894c-495c-a51a-69f450a9a54c

	measure 'Cor CVSS' =
			VAR _s = MAX ( CYBER_Vulnerabilidades[CVSS_Score] )
			RETURN
			    SWITCH ( TRUE (), _s >= 9, "#F1948A", _s >= 7, "#F5B041", _s >= 4, "#F9E79F", "#82E0AA" )
		displayFolder: Cibersegurança\Vulnerabilidades
		lineageTag: 7cc1a02c-a753-44ec-a79b-15eac76b7c98

	column ID_Vuln
		dataType: string
		lineageTag: cd5eee3e-160a-4c9c-9a7b-54d82a2baa99
		summarizeBy: none
		sourceColumn: ID_Vuln

	column Data_Descoberta
		dataType: dateTime
		formatString: Long Date
