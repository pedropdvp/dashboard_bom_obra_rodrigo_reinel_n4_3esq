table ATIVOS_Hardware
	lineageTag: ae9f3b19-6b5e-4830-bfa6-049156a82143

	measure 'Total Hardware' = COUNTROWS ( ATIVOS_Hardware )
		formatString: #,0
		displayFolder: Ativos TI
		lineageTag: 66f5abdd-cf2a-45af-b8dc-5f65b01b5a6c

	measure 'Hardware Ativo' = CALCULATE ( [Total Hardware], ATIVOS_Hardware[Estado] = "Ativo" ) + 0
		formatString: #,0
		displayFolder: Ativos TI
		lineageTag: 32bd518b-39d2-4eb8-bc6a-bbdd182640a8

	measure 'Valor Total HW' = SUM ( ATIVOS_Hardware[Custo_Aquisição_€] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Ativos TI
		lineageTag: 21352237-d6be-481c-854c-edc08a39e0f7

	measure 'Custo Manutenção HW' = SUM ( ATIVOS_Hardware[Custo_Manutenção_€] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Ativos TI
		lineageTag: 7109bae1-dcec-4a87-b456-6e8e003df786

	measure 'Garantias a Expirar 90d' =
			VAR _hoje = TODAY ()
			RETURN
			    CALCULATE ( [Total Hardware], ATIVOS_Hardware[Data_Garantia] >= _hoje && ATIVOS_Hardware[Data_Garantia] <= _hoje + 90 ) + 0
		formatString: #,0
		displayFolder: Ativos TI
		lineageTag: 05f6731a-1475-4339-b537-8c83d3d36952

