	measure 'Scorecard Tickets' =
			VAR _v = [MoM Tickets %]
			RETURN
			    IF (
			        ISBLANK ( _v ), "–",
			        SWITCH ( TRUE (), _v > 0, "▲ ", _v < 0, "▼ ", "→ " ) & FORMAT ( _v, "+0.0%;-0.0%;0.0%" )
			    )
		displayFolder: Visão Geral
		lineageTag: b60e6302-a336-4be0-9190-5ba12cada691

	measure 'Scorecard Incidentes' =
			VAR _v = [MoM Incidentes %]
