	measure 'Cor SLA' = SWITCH ( TRUE (), ISBLANK ( [% SLA Cumprido] ), "#9AA5B1", [% SLA Cumprido] >= [Meta SLA], "#2ECC71", [% SLA Cumprido] >= 0.85, "#F39C12", "#E74C3C" )
		displayFolder: Help Desk
		lineageTag: 08868e53-1b98-453b-8e9a-3d620df9bb12

	measure 'Cor SLA Ticket' = SWITCH ( SELECTEDVALUE ( HELPDESK_Tickets[SLA_Cumprido] ), "Sim", "#82E0AA", "Não", "#F1948A" )
		displayFolder: Help Desk
		lineageTag: c8e12d8d-2790-4bc7-9962-bae7387e3853

	measure 'Tickets Mês Atual' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 )
			RETURN
			    CALCULATE (
			        [Total Tickets],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: #,0
		displayFolder: Help Desk\MoM
		lineageTag: e85f8d41-2dd1-46dd-9851-5c31b045a281

	measure 'Tickets Mês Anterior' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 )
			RETURN
			    CALCULATE (
			        [Total Tickets],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: #,0
		displayFolder: Help Desk\MoM
		lineageTag: 80dd5334-be7d-48c1-83eb-1b4c026c5757

	measure 'MoM Tickets %' = DIVIDE ( [Tickets Mês Atual] - [Tickets Mês Anterior], [Tickets Mês Anterior] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Help Desk\MoM
		lineageTag: b99ecdc4-9d6a-4450-a23d-2c4013262da1

	measure '% SLA Mês Atual' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 )
			RETURN
			    CALCULATE (
			        [% SLA Cumprido],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Help Desk\MoM
		lineageTag: 40fbab79-6160-421d-825b-0d01afa5a22b

	measure '% SLA Mês Anterior' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 )
			RETURN
