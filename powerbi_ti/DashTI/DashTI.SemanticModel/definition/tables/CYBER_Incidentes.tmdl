table CYBER_Incidentes
	lineageTag: 5df73588-06de-47b1-9f9c-37d7e98291cc

	measure 'Total Incidentes' = COUNTROWS ( CYBER_Incidentes )
		formatString: #,0
		displayFolder: Cibersegurança
		lineageTag: 40e7310c-100f-4800-9f66-92acfe40b558

	measure 'Incidentes Críticos' = CALCULATE ( [Total Incidentes], CYBER_Incidentes[Severidade] = "Crítico" ) + 0
		formatString: #,0
		displayFolder: Cibersegurança
		lineageTag: 49a24c83-c4fa-4137-970c-cfd2b29e6748

	measure 'Incidentes Bloqueados' = CALCULATE ( [Total Incidentes], CYBER_Incidentes[Bloqueado] = "Sim" ) + 0
		formatString: #,0
		displayFolder: Cibersegurança
		lineageTag: 06debe2e-5b85-416b-ac71-1a07751bee38

	measure 'Taxa de Bloqueio' = DIVIDE ( [Incidentes Bloqueados], [Total Incidentes] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Cibersegurança
		lineageTag: ec19323a-b640-4bed-9d85-f527009bc2fe

	measure 'Impacto Total' = SUM ( CYBER_Incidentes[Impacto_€] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Cibersegurança
		lineageTag: c4ff7e9d-0130-47c4-878f-9c142ea057ee

	measure 'Impacto Não Bloqueado' = CALCULATE ( [Impacto Total], CYBER_Incidentes[Bloqueado] = "Não" )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Cibersegurança
		lineageTag: 7d53327a-c5c0-4b86-a2d5-5bccc953ec0e

	measure 'Impacto Médio por Incidente' = DIVIDE ( [Impacto Total], [Total Incidentes] )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Cibersegurança
		lineageTag: 4d036f1e-7269-4f27-98b4-2a192edfa501

	measure 'Tempo Médio Deteção (min)' = AVERAGE ( CYBER_Incidentes[Tempo_Deteção_Min] )
		formatString: #,0.00
		displayFolder: Cibersegurança
		lineageTag: fcfb1f66-ad6a-47e5-855a-7f40dec5ac2b

	measure 'Incidentes Mês Atual' =
			VAR _ref = MAX ( CYBER_Incidentes[Data_Hora] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 ) + 1
			RETURN
			    CALCULATE (
			        [Total Incidentes],
			        REMOVEFILTERS ( CYBER_Incidentes[Ano], CYBER_Incidentes[Mês] ),
			        CYBER_Incidentes[Data_Hora] >= _ini && CYBER_Incidentes[Data_Hora] < _fim
			    )
		formatString: #,0
		displayFolder: Cibersegurança\MoM
		lineageTag: c384b0f4-e4e5-4ac3-9526-ddaa7f4f1682

	measure 'Incidentes Mês Anterior' =
			VAR _ref = MAX ( CYBER_Incidentes[Data_Hora] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 ) + 1
			RETURN
			    CALCULATE (
			        [Total Incidentes],
			        REMOVEFILTERS ( CYBER_Incidentes[Ano], CYBER_Incidentes[Mês] ),
			        CYBER_Incidentes[Data_Hora] >= _ini && CYBER_Incidentes[Data_Hora] < _fim
			    )
		formatString: #,0
		displayFolder: Cibersegurança\MoM
		lineageTag: 40208dad-745f-4d7e-a59d-e8cad1391ca4

	measure 'MoM Incidentes %' = DIVIDE ( [Incidentes Mês Atual] - [Incidentes Mês Anterior], [Incidentes Mês Anterior] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Cibersegurança\MoM
		lineageTag: 3cd53b20-c453-4a55-9565-5c26332e9429

	measure 'Impacto Mês Atual' =
			VAR _ref = MAX ( CYBER_Incidentes[Data_Hora] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 ) + 1
			RETURN
			    CALCULATE (
			        [Impacto Total],
			        REMOVEFILTERS ( CYBER_Incidentes[Ano], CYBER_Incidentes[Mês] ),
			        CYBER_Incidentes[Data_Hora] >= _ini && CYBER_Incidentes[Data_Hora] < _fim
			    )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Cibersegurança\MoM
		lineageTag: 2633addc-b47f-4440-8985-2626fcf8bab3

	measure 'Impacto Mês Anterior' =
			VAR _ref = MAX ( CYBER_Incidentes[Data_Hora] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 ) + 1
			RETURN
			    CALCULATE (
			        [Impacto Total],
			        REMOVEFILTERS ( CYBER_Incidentes[Ano], CYBER_Incidentes[Mês] ),
			        CYBER_Incidentes[Data_Hora] >= _ini && CYBER_Incidentes[Data_Hora] < _fim
			    )
		formatString: #,0 €;-#,0 €;#,0 €
		displayFolder: Cibersegurança\MoM
		lineageTag: 953ce9a8-6828-42e5-b5c9-f97e66c6147c

	measure 'Incidentes YTD' =
			VAR _ref = MAX ( CYBER_Incidentes[Data_Hora] )
			RETURN
			    CALCULATE ( [Total Incidentes], REMOVEFILTERS ( CYBER_Incidentes[Mês] ), CYBER_Incidentes[Data_Hora] >= DATE ( YEAR ( _ref ), 1, 1 ) && CYBER_Incidentes[Data_Hora] <= _ref )
		formatString: #,0
		displayFolder: Cibersegurança\MoM
		lineageTag: f0d51a03-a68a-4fb3-b0bd-abca967a2f59

	measure 'Total Incidentes (por Ano)' = CALCULATE ( [Total Incidentes], TREATAS ( VALUES ( HELPDESK_Tickets[Ano] ), CYBER_Incidentes[Ano] ) )
		formatString: #,0
		displayFolder: Visão Geral
		lineageTag: dd489931-6527-4d60-ad82-1fb578191a34

	measure 'Impacto (por Ano)' = CALCULATE ( [Impacto Total], TREATAS ( VALUES ( HELPDESK_Tickets[Ano] ), CYBER_Incidentes[Ano] ) )
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Visão Geral
		lineageTag: 1b7def9d-92fb-49dc-8316-ed18f5d0d880

