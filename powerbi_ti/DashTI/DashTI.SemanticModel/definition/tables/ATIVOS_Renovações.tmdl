table ATIVOS_Renovações
	lineageTag: 919931fe-2b55-470a-963e-26f5372f6132

	measure 'Total Renovações' = COUNTROWS ( 'ATIVOS_Renovações' )
		formatString: #,0
		displayFolder: Ativos TI\Renovações
		lineageTag: 2858b218-cf4a-4bbc-aa47-c6229e39ef85

	measure 'Renovações Urgentes' = CALCULATE ( [Total Renovações], 'ATIVOS_Renovações'[Estado_Alerta] = "Urgente" ) + 0
		formatString: #,0
		displayFolder: Ativos TI\Renovações
		lineageTag: 3c78126d-35bc-47d4-818e-591f701660b7

	measure 'Renovações Em Breve' = CALCULATE ( [Total Renovações], 'ATIVOS_Renovações'[Estado_Alerta] = "Em Breve" ) + 0
		formatString: #,0
		displayFolder: Ativos TI\Renovações
		lineageTag: ffe49bfb-46e0-4f9a-bc67-c7194a6243fd

	measure 'Renovações Expiradas' = CALCULATE ( [Total Renovações], 'ATIVOS_Renovações'[Estado_Alerta] = "Expirado" ) + 0
		formatString: #,0
		displayFolder: Ativos TI\Renovações
		lineageTag: 372eaf9e-9674-4268-a386-026e2f7a0b3f

	measure 'Custo Renovações' = SUM ( 'ATIVOS_Renovações'[Custo_€] )
		formatString: #,0.00 €;-#,0.00 €;#,0.00 €
		displayFolder: Ativos TI\Renovações
		lineageTag: 3f3bf39d-0422-4bb2-b682-87c8881ec773

	measure 'Cor Estado Alerta' = SWITCH ( SELECTEDVALUE ( 'ATIVOS_Renovações'[Estado_Alerta] ), "Expirado", "#F1948A", "Urgente", "#F5B041", "Em Breve", "#F9E79F", "OK", "#82E0AA" )
		displayFolder: Ativos TI\Renovações
		lineageTag: f1f95735-64fd-4996-af0e-d44d67a4e601

