	measure 'Cor SLA' = SWITCH ( TRUE (), ISBLANK ( [% SLA Cumprido] ), "#9AA5B1", [% SLA Cumprido] >= [Meta SLA], "#2ECC71", [% SLA Cumprido] >= 0.85, "#F39C12", "#E74C3C" )
		displayFolder: Help Desk
		lineageTag: 8d8707a9-8277-4360-9a41-082081d09764

	measure 'Cor SLA Ticket' = SWITCH ( SELECTEDVALUE ( HELPDESK_Tickets[SLA_Cumprido] ), "Sim", "#82E0AA", "Não", "#F1948A" )
		displayFolder: Help Desk
		lineageTag: b117064d-09f2-4e35-889f-fc97afe35502

	measure 'Tickets Mês Atual' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 )
			RETURN
			    CALCULATE (
			        [Total Tickets],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: #,0
		displayFolder: Help Desk\MoM
		lineageTag: 3ed9848c-3e6f-44ee-9ada-76725f61f4a5

	measure 'Tickets Mês Anterior' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 )
			RETURN
			    CALCULATE (
			        [Total Tickets],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: #,0
		displayFolder: Help Desk\MoM
		lineageTag: 6f321525-c2d3-45b8-b995-56873e88341b

	measure 'MoM Tickets %' = DIVIDE ( [Tickets Mês Atual] - [Tickets Mês Anterior], [Tickets Mês Anterior] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Help Desk\MoM
		lineageTag: 88731031-e122-47a0-a5ef-f2034fd69d69

	measure '% SLA Mês Atual' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -1 ) + 1
			VAR _fim = EOMONTH ( _ref, 0 )
			RETURN
			    CALCULATE (
			        [% SLA Cumprido],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Help Desk\MoM
		lineageTag: 1bbfb59f-f89e-43d8-96d2-f042378fddb4

	measure '% SLA Mês Anterior' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			VAR _ini = EOMONTH ( _ref, -2 ) + 1
			VAR _fim = EOMONTH ( _ref, -1 )
			RETURN
			    CALCULATE (
			        [% SLA Cumprido],
			        REMOVEFILTERS ( HELPDESK_Tickets[Ano], HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ),
			        HELPDESK_Tickets[Data_Abertura] >= _ini && HELPDESK_Tickets[Data_Abertura] <= _fim
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Help Desk\MoM
		lineageTag: 0fefded3-bbc3-4d39-8051-42a76777a91a

	measure 'Var SLA p.p.' = ( [% SLA Mês Atual] - [% SLA Mês Anterior] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Help Desk\MoM
		lineageTag: 007782e4-1425-46cf-b9f9-60d02fe772b3

	measure 'Tickets YTD' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			RETURN
			    CALCULATE ( [Total Tickets], REMOVEFILTERS ( HELPDESK_Tickets[Mês], HELPDESK_Tickets[Semana] ), HELPDESK_Tickets[Data_Abertura] >= DATE ( YEAR ( _ref ), 1, 1 ) && HELPDESK_Tickets[Data_Abertura] <= _ref )
		formatString: #,0
		displayFolder: Help Desk\MoM
		lineageTag: 26f87e78-4b79-466b-ae1d-22c4e289f7b4

	measure 'Custos TI Mês Atual' = [Custo Total Tickets Mês Atual] + [Impacto Mês Atual]
