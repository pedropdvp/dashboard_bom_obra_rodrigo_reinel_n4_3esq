	measure 'Título Dashboard' = "Dashboard TI  ·  " & FORMAT ( MIN ( HELPDESK_Tickets[Data_Abertura] ), "yyyy" ) & "–" & FORMAT ( MAX ( HELPDESK_Tickets[Data_Abertura] ), "yyyy" )
		displayFolder: Visão Geral
		lineageTag: 0f551808-4026-4fae-af92-74b7790b9d54

	measure 'Período Referência MoM' =
			VAR _ref = MAX ( HELPDESK_Tickets[Data_Abertura] )
			RETURN
			    "Mês actual: " & FORMAT ( _ref, "mmm yyyy" ) & "  vs  " & FORMAT ( EOMONTH ( _ref, -1 ), "mmm yyyy" )
		displayFolder: Visão Geral
		lineageTag: 0f584fbb-630e-4fb0-bc68-343a4a871349

